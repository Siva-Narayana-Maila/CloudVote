# Copy this file to ".env" on the VM and fill in every value.
# The stack refuses to start if any of them is missing.

# Public hostname that points at this VM. No domain purchase needed: take the
# VM's external IP, replace dots with dashes, and add ".sslip.io".
# Example: IP 34.93.12.45  ->  DOMAIN=34-93-12-45.sslip.io
DOMAIN=

# Generate each of these with:  openssl rand -hex 24
# (hex only — special characters would break the database URL)
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_API_KEY=